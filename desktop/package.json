{
  "name": "dark-fisic-desktop",
  "private": true,
  "version": "0.1.9",
  "description": "Sistema de gestão da academia DARK FISIC",
  "type": "module",
  "main": "main.js",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.4.3": true
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.4",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "qrcode": "^1.5.4",
    "zod": "^4.5.4"
  },
  "scripts": {
    "preparar": "node scripts/preparar.mjs && node scripts/verificar-nativos.mjs",
    "rebuild-nativos": "electron-rebuild -f -w better-sqlite3",
    "iniciar": "electron .",
    "test": "node --test tests/*.test.js",
    "atualizacao": "node scripts/gerar-atualizacao.mjs",
    "build": "npm run preparar && electron-builder --win && node scripts/testar-pacote.mjs && npm run atualizacao",
    "testar-pacote": "node scripts/testar-pacote.mjs",
    "icones": "electron scripts/gerar-icones.cjs"
  },
  "productName": "DARK FISIC",
  "author": "DARK FISIC",
  "build": {
    "appId": "com.darkfisic.sistema",
    "productName": "DARK FISIC",
    "directories": {
      "output": "instalador",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.cjs",
      "preload-sistema.cjs",
      "painel/**/*",
      "sistema/**/*",
      "package.json",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icone.ico",
      "artifactName": "DARK-FISIC-Instalador-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DARK FISIC",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  }
}
